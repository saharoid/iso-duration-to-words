{
  "name": "iso-duration-to-words",
  "version": "2.0.0",
  "description": "Convert ISO 8601 duration strings into human-readable sentences in English, Serbian, German, Spanish, Italian and French.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-module-types.js",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "iso8601",
    "duration",
    "human-readable",
    "typescript",
    "date",
    "time",
    "i18n",
    "localization",
    "words"
  ],
  "author": "Branislav Jankovic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saharoid/iso-duration-to-words.git"
  },
  "homepage": "https://github.com/saharoid/iso-duration-to-words#readme",
  "bugs": {
    "url": "https://github.com/saharoid/iso-duration-to-words/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}
